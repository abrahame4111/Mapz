{
  "name": "nfs-nav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node tools/package-usb/gradle.mjs assembleDebug",
    "pack:usb": "node tools/package-usb/pack.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.2",
    "maplibre-gl": "^4.7.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/cli": "^6.2.2",
    "@vitejs/plugin-legacy": "^8.2.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
