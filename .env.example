# TileJSON URL of an OpenMapTiles-schema vector tile source (default: OpenFreeMap, keyless, attribution required).
# Swap for MapTiler/self-hosted PMTiles here; never commit real keys.
VITE_TILE_URL=https://tiles.openfreemap.org/planet
# Simulator start position
VITE_START_LAT=59.3293
VITE_START_LNG=18.0686

# Spotify (lyrics mode). The Client ID is public; put the real one in .env.local (git-ignored).
# NEVER put the client secret here or anywhere in the app: login uses PKCE and does not need it.
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_REDIRECT_URI=https://mapz-b9u.pages.dev/api/spotify/callback

# Address of your Cloudflare Pages relay (see docs/spotify-pairing.md), e.g. https://mapz-relay.pages.dev
# Used for phone-based Spotify login and as an extra routing path.
VITE_RELAY_URL=

# OpenRouteService routing key (free: https://openrouteservice.org/dev/#/signup). The head unit can reach this service.
# It ends up inside the built app, so use a free key you can replace. Put the real one in .env.local, never here.
VITE_ORS_API_KEY=
